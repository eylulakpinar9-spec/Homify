@* DOSYA YOLU: HomiefyC/Views/USERs/Login.cshtml *@
@* Mevcut Login.cshtml ile TAMAMEN degistir *@
@model HomiefyC.ViewModels.LoginViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homify | Giris Yap</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/styles.css">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>
</head>
<body>
    <nav class="navbar reveal">
        <div class="nav-container">
            <a href="/Home/Index" class="logo" style="text-decoration:none;">
                <div class="logo-icon"><ion-icon name="home"></ion-icon></div>
                <span>Homify</span>
            </a>
            <button id="themeToggle" class="theme-switch" aria-label="Toggle Theme">
                <ion-icon name="sunny" class="sun-icon"></ion-icon>
                <ion-icon name="moon" class="moon-icon"></ion-icon>
            </button>
        </div>
    </nav>

    <main class="container" style="display:flex; justify-content:center; align-items:center; min-height:70vh;">
        <div class="bento-box bg-white border-radius-large reveal"
             style="width:100%; max-width:450px; padding:3rem; text-align:center;
                    box-shadow:0 20px 40px -10px rgba(0,0,0,0.1); border:1px solid var(--border-color);">

            <h1 class="ultra-title" style="font-size:2.5rem; margin-bottom:0.5rem;">Tekrar Hosgeldiniz</h1>
            <p class="subtitle" style="margin-bottom:2rem;">Homify hesabiniza giris yapin</p>

            @* Validation hatalari *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background:#fee2e2; color:#991b1b; padding:12px; border-radius:8px; margin-bottom:16px; text-align:left;">
                    @Html.ValidationSummary(false)
                </div>
            }

            @* TempData mesaji *@
            @if (TempData["Success"] != null)
            {
                <div style="background:#d1fae5; color:#065f46; padding:12px; border-radius:8px; margin-bottom:16px; font-weight:600;">
                    @TempData["Success"]
                </div>
            }

            @using (Html.BeginForm("Login", "USERs", FormMethod.Post,
                    new { style = "display:flex; flex-direction:column; gap:1rem; text-align:left;" }))
            {
                @Html.AntiForgeryToken()

                <div>
                    @Html.LabelFor(m => m.Email, new { style = "font-weight:600; font-size:0.9rem;" })
                    @Html.TextBoxFor(m => m.Email, new
                    {
                        type = "email",
                        placeholder = "ornek@email.com",
                        style = "width:100%; padding:1rem; border-radius:var(--radius-sm); border:1px solid var(--border-color); background:var(--bg-color); color:var(--text-primary); font-size:1rem; outline:none; box-sizing:border-box;"
                    })
                    @Html.ValidationMessageFor(m => m.Email, "", new { style = "color:red; font-size:0.8rem;" })
                </div>

                <div>
                    @Html.LabelFor(m => m.Password, new { style = "font-weight:600; font-size:0.9rem;" })
                    <div style="position:relative;">
                        @Html.PasswordFor(m => m.Password, new
                        {
                            id = "passwordInput",
                            placeholder = "Sifrenizi girin",
                            style = "width:100%; padding:1rem; padding-right:3rem; border-radius:var(--radius-sm); border:1px solid var(--border-color); background:var(--bg-color); color:var(--text-primary); font-size:1rem; outline:none; box-sizing:border-box;"
                        })
                        <button type="button" onclick="togglePassword()"
                                style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:var(--text-muted);">
                            <ion-icon name="eye-outline" id="eyeIcon"></ion-icon>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { style = "color:red; font-size:0.8rem;" })
                </div>

                <button type="submit" class="btn-primary"
                        style="margin-top:1rem; width:100%; justify-content:center; padding:1.2rem;">
                    <span class="btn-text">Giris Yap <ion-icon name="log-in-outline"></ion-icon></span>
                    <div class="wave-bg"></div>
                </button>
            }

            <p style="margin-top:2rem; color:var(--text-muted); font-size:0.9rem;">
                Hesabiniz yok mu?
                <a href="/USERs/Create" style="color:var(--text-primary); font-weight:600; text-decoration:none;">Kayit Ol</a>
            </p>
        </div>
    </main>

    <script src="~/Scripts/app.js"></script>
    <script>
        function togglePassword() {
            var inp = document.getElementById('passwordInput');
            var ico = document.getElementById('eyeIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                ico.setAttribute('name', 'eye-off-outline');
            } else {
                inp.type = 'password';
                ico.setAttribute('name', 'eye-outline');
            }
        }
    </script>
</body>
</html>
