@model IEnumerable<Homiefy.Models.ListingDetailsView>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homiefy | Favorites</title>
    <!-- Import Inter Font for modern Neative aesthetic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/styles.css">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script>
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar reveal">
        <div class="nav-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <div class="logo-icon"><ion-icon name="home"></ion-icon></div>
                <span>Homiefy</span>
            </a>
            <div class="nav-links">
                <a href="@Url.Action("Index", "Home")">Listings</a>
                <a href="@Url.Action("MyApplications", "Home")">My Applications</a>
                <a href="@Url.Action("Favorites", "Home")" class="active">Favorites</a>
                <a href="@Url.Action("Messages", "Home")">Messages</a>
            </div>
            <div class="nav-actions">
                <button id="themeToggle" class="theme-switch" aria-label="Toggle Theme">
                    <ion-icon name="sunny" class="sun-icon"></ion-icon>
                    <ion-icon name="moon" class="moon-icon"></ion-icon>
                </button>
                <a href="@Url.Action("Profile", "Home")" class="user-profile" style="text-decoration: none;">
                    <span>John Doe</span>
                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed=John" alt="Avatar" class="avatar">
                </a>
                <a href="@Url.Action("Login", "Account")" class="view-apps-btn" style="text-decoration: none;">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>
        </div>
    </nav>

    <main class="container">
        <section class="listings-section reveal delay-1">
            <div class="section-header">
                <h2>Your Favorites</h2>
                <div class="filter-chip" id="favoritesCount">@(Model != null ? Model.Count() : 0) saved</div>
            </div>
            
            <div class="listings-grid" id="favoritesGrid">
                @if (Model != null && Model.Any())
                {
                    int delayCount = 1;
                    foreach (var listing in Model)
                    {
                        var delayClass = $"delay-{(delayCount % 3) + 1}";
                        <div class="listing-card reveal @delayClass">
                            <span class="category-badge">@listing.CategoryName</span>
                            <div style="position: absolute; top: 1.5rem; right: 1.5rem; font-size: 1.5rem; color: var(--accent); cursor: pointer; transition: color 0.2s;" onclick="toggleFavorite(1)">
                                <ion-icon name="heart"></ion-icon>
                            </div>
                            <div style="padding-top: 1.2rem;">
                                <h3 style="padding-right: 3rem;">@listing.Title</h3>
                                <div class="card-location">
                                    <ion-icon name="location"></ion-icon> Location
                                </div>
                                <p>Great place with an amazing view...</p>
                            </div>
                            
                            <div class="card-foot">
                                <div class="card-price">
                                    ₺@listing.Price<span class="month">/mo</span>
                                </div>
                                <!-- Applying logic wrapper -->
                                <button class="view-apps-btn" onclick="applyToListing(1)">
                                    <ion-icon name="paper-plane-outline"></ion-icon> Apply
                                </button>
                            </div>
                        </div>
                        delayCount++;
                    }
                }
                else
                {
                    <div style="grid-column: 1/-1; text-align: center; padding: 4rem 2rem; background: var(--card-bg); border-radius: var(--radius-lg); border: 1px dashed var(--border-color);">
                        <ion-icon name="heart-dislike-outline" style="font-size: 4rem; color: var(--text-muted); margin-bottom: 1rem;"></ion-icon>
                        <h3 style="color: var(--text-primary); font-size: 1.5rem; margin-bottom: 0.5rem;">No favorites yet</h3>
                        <p style="color: var(--text-muted);">Explore listings and click the heart icon to save them here.</p>
                    </div>
                }
            </div>
        </section>
    </main>

    <script src="~/app.js"></script>
</body>
</html>
