@model IEnumerable<HomiefyC.Models.LISTING>
@{
    ViewBag.Title = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-main neative-dark border-radius-large reveal delay-1">
        <div class="hero-content">
            <div class="badge-pill light">Trusted by @ViewBag.TotalUsers users <ion-icon name="arrow-forward-outline"></ion-icon></div>
            <h1 class="ultra-title">Clean space<br>starts here</h1>
            <p>Find your perfect roommate and premium living spaces tailored to your needs.</p>
            <div class="search-bar">
                <ion-icon name="search-outline"></ion-icon>
                <input type="text" id="citySearch" placeholder="Search categories...">
                <button class="btn-primary" id="searchBtn">
                    <span class="btn-text">Explore <ion-icon name="arrow-forward-outline"></ion-icon></span>
                    <div class="wave-bg"></div>
                </button>
            </div>
        </div>
    </div>

    <!-- Bento Stats -->
    <div class="bento-grid">
        <div class="bento-box bg-white border-radius-large stat-box reveal delay-2">
            <div class="bento-header">
                <h3>Categories</h3>
                <p class="subtitle">Listings by Category</p>
            </div>
            <div style="position: relative; height:200px; width:100%">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>

        <div class="bento-box neative-accent border-radius-large stat-box reveal delay-3">
            <div class="bento-header dark-text">
                <h3>Market Average</h3>
                <p class="subtitle">Average Rent by Category</p>
            </div>
            <div style="position: relative; height:200px; width:100%">
                <canvas id="rentChart"></canvas>
            </div>
            <div class="accent-decoration">
                <ion-icon name="trending-up-outline"></ion-icon>
            </div>
        </div>
    </div>
</section>

<!-- Dynamic Listings Section -->
<section class="listings-section">
    <div class="section-header reveal">
        <h2>Recent Matches</h2>
        <div class="filter-chip">@ViewBag.TotalListings total listings</div>
    </div>
    
    <div class="listings-grid">
        @foreach (var item in Model) {
            <div class="bento-box bg-white border-radius-large reveal" style="padding: 1.5rem; border: 1px solid var(--border-color);">
                <div style="display:flex; justify-content:space-between; margin-bottom: 10px;">
                    <span class="badge-pill light">@item.CATEGORY.CategoryName</span>
                    <strong style="color:var(--text-primary);">@item.ROOMs.FirstOrDefault()?.MonthlyRent.ToString("C")</strong>
                </div>
                <h3 style="margin-bottom: 10px;">@item.Title</h3>
                <p style="color:var(--text-muted); font-size: 0.9rem; margin-bottom: 15px;">@item.Description</p>
                <a href="/LISTINGs/Details/@item.ListingID" class="btn-primary" style="display:inline-block; padding: 5px 15px; text-decoration:none;">View</a>
            </div>
        }
    </div>
</section>

@section scripts {
    <!-- Load Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Category Chart (Doughnut)
            var catCtx = document.getElementById('categoryChart').getContext('2d');
            var catChart = new Chart(catCtx, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(ViewBag.CategoryLabels)],
                    datasets: [{
                        data: [@ViewBag.CategoryData],
                        backgroundColor: ['#0F172A', '#64748B', '#E6FB00', '#CBD5E1'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right' } }
                }
            });

            // Rent Chart (Bar)
            var rentCtx = document.getElementById('rentChart').getContext('2d');
            var rentChart = new Chart(rentCtx, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(ViewBag.RentLabels)],
                    datasets: [{
                        label: 'Avg Rent',
                        data: [@ViewBag.RentData],
                        backgroundColor: '#111A29',
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        });
    </script>
}
